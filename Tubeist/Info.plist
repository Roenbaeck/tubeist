<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Google OAuth2 Callback</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.417360709076-6golrsu19ipsvdbsgce4e9fml9bru8dr</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- User-configured overlay and status servers may only support HTTP.
		     Do not add the web-content/media/local exception keys alongside this:
		     their presence overrides NSAllowsArbitraryLoads on iOS 10 and later. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<!-- Restore full ATS protection for Tubeist's YouTube and Google services.
		     Listed domains use ATS defaults independently of the global exception. -->
		<key>NSExceptionDomains</key>
		<dict>
			<key>youtube.com</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
			<key>googleapis.com</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
			<key>google.com</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Tubeist connects to the status server you choose on your local network to display its text on your Apple Watch.</string>
	<key>UIFileSharingEnabled</key>
	<true/>
</dict>
</plist>
